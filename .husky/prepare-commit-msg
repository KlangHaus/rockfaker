#!/usr/bin/env sh
# Strip Cursor-injected Co-authored-by trailers (org-konvention: ingen Co-authored-by).
COMMIT_MSG_FILE=$1
if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

TMP_FILE="${COMMIT_MSG_FILE}.tmp"
grep -v -E '^Co-authored-by:' "$COMMIT_MSG_FILE" > "$TMP_FILE"
mv "$TMP_FILE" "$COMMIT_MSG_FILE"
