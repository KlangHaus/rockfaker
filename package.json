{
  "name": "rockfaker",
  "version": "1.1.0",
  "description": "Seeded fake data for KlangHaus — faker library, JSON fixtures, and Mockoon HTTP stubs",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locales/da": {
      "types": "./dist/locales/da/index.d.ts",
      "import": "./dist/locales/da/index.js"
    },
    "./locales/en": {
      "types": "./dist/locales/en/index.d.ts",
      "import": "./dist/locales/en/index.js"
    },
    "./fixtures/*": "./fixtures/*",
    "./mockoon/*": "./mockoon/*"
  },
  "files": [
    "dist",
    "fixtures",
    "mockoon",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run tsc",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "playground": "bun run playground.ts",
    "fixtures:gen": "bun run scripts/generate-fixtures.ts",
    "fixtures:check": "bun run scripts/generate-fixtures.ts --check",
    "mock:etude": "bunx mockoon-cli start --data mockoon/etude.json --port 4010",
    "mock:stop": "bunx mockoon-cli stop --data mockoon/etude.json",
    "mock:up": "bun run fixtures:gen && bun run mock:etude",
    "prepare": "husky"
  },
  "keywords": [
    "faker",
    "fake-data",
    "mock",
    "mockoon",
    "fixtures",
    "test-data",
    "rockstar",
    "education",
    "klanghaus",
    "etude",
    "seeded"
  ],
  "author": "Allan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "devDependencies": {
    "@mockoon/cli": "^9.4.0",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "^5.4.0"
  }
}
